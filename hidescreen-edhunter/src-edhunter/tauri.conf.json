{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BestPerformance",
  "mainBinaryName": "BestPerformance",
  "version": "1.0.0",
  "identifier": "com.hidescreen.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Node Terminal",
        "width": 400,
        "height": 200,
        "minWidth": 200,
        "minHeight": 150,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "card",
        "title": "Node Terminal",
        "url": "index.html",
        "width": 280,
        "height": 240,
        "x": 520,
        "y": 100,
        "minWidth": 180,
        "minHeight": 120,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
